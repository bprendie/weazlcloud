# Copy to deploy/compose.env and use --env-file deploy/compose.env.
# Keep account/vault passwords out of this file.
WEAZLCLOUD_IMAGE=weazlcloud:local

# Default: Compose-managed named volume. For an existing installation, keep
# its current mount; an absolute host directory can be selected here instead.
# WEAZLCLOUD_DATA_SOURCE=/exports/dockervolume/weazlcloud

# Small-host sidecar limits. These constrain the worker and its codec children;
# API/source readers have separate admission and container resource budgets.
WEAZLCLOUD_PHOTO_CPUS=1.0
WEAZLCLOUD_PHOTO_MEMORY_LIMIT=2g
WEAZLCLOUD_PREVIEW_RENDERER=auto
WEAZLCLOUD_PHOTO_SCHEDULE=balanced

# Set true when desk HTTPS terminates at your reverse proxy.
# WEAZLCLOUD_SECURE_COOKIES=true

# Optional positive integers: leave commented for automatic host/cgroup sizing.
# Explicit worker counts remain subject to the detected CPU ceiling.
# WEAZLCLOUD_PREVIEW_BACKGROUND_WORKERS=1
# WEAZLCLOUD_PREVIEW_TOTAL_WORKERS=1
# WEAZLCLOUD_PREVIEW_SOURCE_READERS=1
# WEAZLCLOUD_PREVIEW_MEMORY_BYTES=536870912

# Mobile storage finalization defaults to detected CPU/RAM capacity.
# Hard limits: 1-8 globally, 1-8 per owner; omit for automatic small-host sizing.
# WEAZLCLOUD_MOBILE_FINALIZE_WORKERS=4
# WEAZLCLOUD_MOBILE_FINALIZE_WORKERS_PER_OWNER=2

# Optional positive integer caps for generated encrypted previews only.
# WEAZLCLOUD_PREVIEW_OWNER_BYTES=4294967296
# WEAZLCLOUD_PREVIEW_OWNER_FILES=200000
# WEAZLCLOUD_PREVIEW_NODE_BYTES=8589934592

# Forward fallbacks, without changing original files or the image/data format.
# WEAZLCLOUD_PREVIEW_BUNDLE=off
# WEAZLCLOUD_PREVIEW_READER=off
